{
  "$description": "The Oberdorfer Team design tokens, exported from assets/css/tokens.css. Proposed, awaiting approval.",
  "color": {
    "navy": {
      "$type": "color",
      "$value": "#071D2D",
      "$description": "Midnight Navy   \u2014 p1 cover, p4 stat panel, p7, p8"
    },
    "navy-800": {
      "$type": "color",
      "$value": "#0E2738",
      "$description": "raised navy surface"
    },
    "navy-700": {
      "$type": "color",
      "$value": "#1A3446",
      "$description": "navy hover / borders on navy"
    },
    "ink": {
      "$type": "color",
      "$value": "#142A38",
      "$description": "Text Ink        \u2014 body copy on ivory, p2\u2013p6"
    },
    "ivory": {
      "$type": "color",
      "$value": "#F7F3EC",
      "$description": "Warm Ivory      \u2014 page ground, p2\u2013p6"
    },
    "paper": {
      "$type": "color",
      "$value": "#FBF9F5",
      "$description": "lifted ivory for inputs and raised cards"
    },
    "sandstone": {
      "$type": "color",
      "$value": "#E9E2D5",
      "$description": "Sandstone       \u2014 p3 history band"
    },
    "sandstone-2": {
      "$type": "color",
      "$value": "#DDD3C2",
      "$description": "deeper sandstone for borders on sand"
    },
    "gold": {
      "$type": "color",
      "$value": "#B49A65",
      "$description": "Antique Gold    \u2014 rules, frames, labels on navy"
    },
    "gold-ink": {
      "$type": "color",
      "$value": "#7A6438",
      "$description": "Gold Ink        \u2014 gold TEXT on light grounds (5.1:1)"
    },
    "gold-pale": {
      "$type": "color",
      "$value": "#D9C9A5",
      "$description": "gold tint for hairlines on navy, highlights"
    },
    "slate": {
      "$type": "color",
      "$value": "#59656A",
      "$description": "Slate           \u2014 captions, metadata"
    },
    "mist": {
      "$type": "color",
      "$value": "#A3AEB3",
      "$description": "Slate on navy   \u2014 secondary text on navy (7.6:1)"
    }
  },
  "semantic": {
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{color.ivory}"
      },
      "raised": {
        "$type": "color",
        "$value": "{color.paper}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.sandstone}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.navy}"
      },
      "inverse-raised": {
        "$type": "color",
        "$value": "{color.navy-800}"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgb(7 29 45 / 0.62)"
      }
    },
    "text": {
      "display": {
        "$type": "color",
        "$value": "{color.navy}"
      },
      "body": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.slate}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.gold-ink}"
      },
      "on-inverse": {
        "$type": "color",
        "$value": "{color.ivory}"
      },
      "on-inverse-muted": {
        "$type": "color",
        "$value": "{color.mist}"
      },
      "on-inverse-accent": {
        "$type": "color",
        "$value": "{color.gold}"
      },
      "link": {
        "$type": "color",
        "$value": "{color.navy}"
      },
      "link-hover": {
        "$type": "color",
        "$value": "{color.gold-ink}"
      }
    },
    "rule": {
      "gold": {
        "$type": "color",
        "$value": "{color.gold}"
      },
      "hair": {
        "$type": "color",
        "$value": "color-mix(in srgb, var(--ot-gold) 55%, var(--ot-ivory))"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "#DCD4C6"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "input": {
        "$type": "color",
        "$value": "#8E8778"
      },
      "on-inverse": {
        "$type": "color",
        "$value": "{color.navy-700}"
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.navy}"
      },
      "ring-inverse": {
        "$type": "color",
        "$value": "{color.gold-pale}"
      }
    },
    "hover": {
      "tint": {
        "$type": "color",
        "$value": "rgb(7 29 45 / 0.05)"
      },
      "tint-inverse": {
        "$type": "color",
        "$value": "rgb(247 243 236 / 0.07)"
      }
    },
    "press": {
      "tint": {
        "$type": "color",
        "$value": "rgb(7 29 45 / 0.1)"
      }
    },
    "disabled": {
      "bg": {
        "$type": "color",
        "$value": "#ECE7DE"
      },
      "fg": {
        "$type": "color",
        "$value": "#7D7A73"
      },
      "border": {
        "$type": "color",
        "$value": "#D5CEC1"
      }
    },
    "input": {
      "bg": {
        "$type": "color",
        "$value": "{color.paper}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "placeholder": {
        "$type": "color",
        "$value": "#6B7276"
      },
      "border": {
        "$type": "color",
        "$value": "#8E8778"
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "border-focus": {
        "$type": "color",
        "$value": "{color.navy}"
      }
    }
  },
  "status": {
    "success": {
      "$type": "color",
      "$value": "#2F5D45"
    },
    "success-bg": {
      "$type": "color",
      "$value": "#E3ECE4"
    },
    "warning": {
      "$type": "color",
      "$value": "#7A4E0E"
    },
    "warning-bg": {
      "$type": "color",
      "$value": "#F4E9D3"
    },
    "error": {
      "$type": "color",
      "$value": "#9A2B22"
    },
    "error-bg": {
      "$type": "color",
      "$value": "#F6E3DF"
    },
    "info": {
      "$type": "color",
      "$value": "{color.navy}"
    },
    "info-bg": {
      "$type": "color",
      "$value": "#E4E9EC"
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Cormorant Garamond",
          "Cormorant",
          "EB Garamond",
          "Garamond",
          "Times New Roman",
          "serif"
        ]
      },
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Manrope",
          "Avenir Next",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "display": {
        "$type": "fontWeight",
        "$value": 300
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 400
      },
      "heading-strong": {
        "$type": "fontWeight",
        "$value": 500
      },
      "body": {
        "$type": "fontWeight",
        "$value": 400
      },
      "label": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "size": {
      "display-xl": {
        "$type": "dimension",
        "$value": "6rem",
        "$extensions": {
          "com.oberdorfer.fluid": {
            "min": "3.25rem",
            "max": "6rem",
            "css": "clamp(3.25rem, 2.1rem + 5.1vw, 6rem)",
            "viewport": "360px \u2192 1440px"
          }
        }
      },
      "display-l": {
        "$type": "dimension",
        "$value": "4.75rem",
        "$extensions": {
          "com.oberdorfer.fluid": {
            "min": "2.75rem",
            "max": "4.75rem",
            "css": "clamp(2.75rem, 1.95rem + 3.55vw, 4.75rem)",
            "viewport": "360px \u2192 1440px"
          }
        }
      },
      "display-m": {
        "$type": "dimension",
        "$value": "3.5rem",
        "$extensions": {
          "com.oberdorfer.fluid": {
            "min": "2.25rem",
            "max": "3.5rem",
            "css": "clamp(2.25rem, 1.75rem + 2.2vw, 3.5rem)",
            "viewport": "360px \u2192 1440px"
          }
        }
      },
      "h1": {
        "$type": "dimension",
        "$value": "3.25rem",
        "$extensions": {
          "com.oberdorfer.fluid": {
            "min": "2.125rem",
            "max": "3.25rem",
            "css": "clamp(2.125rem, 1.7rem + 1.9vw, 3.25rem)",
            "viewport": "360px \u2192 1440px"
          }
        }
      },
      "h2": {
        "$type": "dimension",
        "$value": "2.75rem",
        "$extensions": {
          "com.oberdorfer.fluid": {
            "min": "1.875rem",
            "max": "2.75rem",
            "css": "clamp(1.875rem, 1.55rem + 1.45vw, 2.75rem)",
            "viewport": "360px \u2192 1440px"
          }
        }
      },
      "h3": {
        "$type": "dimension",
        "$value": "2.125rem",
        "$extensions": {
          "com.oberdorfer.fluid": {
            "min": "1.5rem",
            "max": "2.125rem",
            "css": "clamp(1.5rem, 1.3rem + 0.9vw, 2.125rem)",
            "viewport": "360px \u2192 1440px"
          }
        }
      },
      "h4": {
        "$type": "dimension",
        "$value": "1.625rem",
        "$extensions": {
          "com.oberdorfer.fluid": {
            "min": "1.3125rem",
            "max": "1.625rem",
            "css": "clamp(1.3125rem, 1.2rem + 0.5vw, 1.625rem)",
            "viewport": "360px \u2192 1440px"
          }
        }
      },
      "h5": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "h6": {
        "$type": "dimension",
        "$value": "0.8125rem"
      },
      "lead": {
        "$type": "dimension",
        "$value": "1.3125rem",
        "$extensions": {
          "com.oberdorfer.fluid": {
            "min": "1.125rem",
            "max": "1.3125rem",
            "css": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
            "viewport": "360px \u2192 1440px"
          }
        }
      },
      "body-l": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "body": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "body-s": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "caption": {
        "$type": "dimension",
        "$value": "0.8125rem"
      },
      "label": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "stat": {
        "$type": "dimension",
        "$value": "4rem",
        "$extensions": {
          "com.oberdorfer.fluid": {
            "min": "2.5rem",
            "max": "4rem",
            "css": "clamp(2.5rem, 1.9rem + 2.6vw, 4rem)",
            "viewport": "360px \u2192 1440px"
          }
        }
      }
    },
    "line-height": {
      "display": {
        "$type": "number",
        "$value": 1.02
      },
      "heading": {
        "$type": "number",
        "$value": 1.12
      },
      "body": {
        "$type": "number",
        "$value": 1.65
      },
      "tight": {
        "$type": "number",
        "$value": 1.35
      }
    },
    "letter-spacing": {
      "display": {
        "$type": "dimension",
        "$value": "-0.012em"
      },
      "label": {
        "$type": "dimension",
        "$value": "0.18em"
      },
      "button": {
        "$type": "dimension",
        "$value": "0.14em"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "5": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "7": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "8": {
      "$type": "dimension",
      "$value": "4rem"
    },
    "9": {
      "$type": "dimension",
      "$value": "6rem"
    },
    "10": {
      "$type": "dimension",
      "$value": "8rem"
    }
  },
  "layout": {
    "section-y": {
      "$type": "dimension",
      "$value": "8.5rem",
      "$extensions": {
        "com.oberdorfer.fluid": {
          "min": "4rem",
          "max": "8.5rem",
          "css": "clamp(4rem, 2.6rem + 6vw, 8.5rem)",
          "viewport": "360px \u2192 1440px"
        }
      }
    },
    "gutter": {
      "$type": "dimension",
      "$value": "2rem",
      "$extensions": {
        "com.oberdorfer.fluid": {
          "min": "1rem",
          "max": "2rem",
          "css": "clamp(1rem, 0.6rem + 1.8vw, 2rem)",
          "viewport": "360px \u2192 1440px"
        }
      }
    },
    "page-margin": {
      "$type": "dimension",
      "$value": "5rem",
      "$extensions": {
        "com.oberdorfer.fluid": {
          "min": "1rem",
          "max": "5rem",
          "css": "clamp(1rem, -0.2rem + 5.4vw, 5rem)",
          "viewport": "360px \u2192 1440px"
        }
      }
    },
    "content-max": {
      "$type": "dimension",
      "$value": "82rem"
    },
    "frame-inset": {
      "$type": "dimension",
      "$value": "1.75rem",
      "$extensions": {
        "com.oberdorfer.fluid": {
          "min": "0.75rem",
          "max": "1.75rem",
          "css": "clamp(0.75rem, 0.4rem + 1.4vw, 1.75rem)",
          "viewport": "360px \u2192 1440px"
        }
      }
    },
    "frame-gap": {
      "$type": "dimension",
      "$value": "6px"
    },
    "tick": {
      "$type": "dimension",
      "$value": "9px"
    }
  },
  "radius": {
    "default": {
      "$type": "dimension",
      "$value": "0px"
    }
  },
  "shadow": {
    "1": {
      "$type": "shadow",
      "$value": "0 1px 2px rgb(7 29 45 / 0.06), 0 6px 18px -10px rgb(7 29 45 / 0.18)"
    },
    "2": {
      "$type": "shadow",
      "$value": "0 2px 6px rgb(7 29 45 / 0.08), 0 24px 48px -24px rgb(7 29 45 / 0.35)"
    }
  },
  "motion": {
    "easing": {
      "out": {
        "$type": "cubicBezier",
        "$value": [
          0.16,
          1.0,
          0.3,
          1.0
        ]
      },
      "in-out": {
        "$type": "cubicBezier",
        "$value": [
          0.65,
          0.0,
          0.35,
          1.0
        ]
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "160ms"
      },
      "base": {
        "$type": "duration",
        "$value": "280ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "720ms"
      },
      "reveal": {
        "$type": "duration",
        "$value": "1100ms"
      }
    }
  },
  "breakpoint": {
    "sm": {
      "$type": "dimension",
      "$value": "36rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "52rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "64rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "90rem"
    }
  },
  "z-index": {
    "nav": {
      "$type": "number",
      "$value": 50
    },
    "overlay": {
      "$type": "number",
      "$value": 80
    },
    "modal": {
      "$type": "number",
      "$value": 90
    },
    "toast": {
      "$type": "number",
      "$value": 95
    }
  }
}