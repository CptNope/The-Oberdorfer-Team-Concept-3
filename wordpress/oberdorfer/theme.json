					"name": "96px",
					"size": "6rem"
				},
				{
					"slug": "100",
					"name": "128px",
					"size": "8rem"
				}
			],
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh",
				"ch"
			],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"layout": {
			"contentSize": "46rem",
			"wideSize": "82rem"
		},
		"border": {
			"radius": false,
			"color": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "1",
					"name": "Elevation 1",
					"shadow": "0 1px 2px rgb(7 29 45 / 0.06), 0 6px 18px -10px rgb(7 29 45 / 0.18)"
				},
				{
					"slug": "2",
					"name": "Elevation 2",
					"shadow": "0 2px 6px rgb(7 29 45 / 0.08), 0 24px 48px -24px rgb(7 29 45 / 0.35)"
				}
			]
		},
		"custom": {
			"measure": "68ch",
			"sectionY": "clamp(4rem, 2.6rem + 6vw, 8.5rem)",
			"gutter": "clamp(1rem, 0.6rem + 1.8vw, 2rem)",
			"pageMargin": "clamp(1rem, -0.2rem + 5.4vw, 5rem)",
			"frameInset": "clamp(0.75rem, 0.4rem + 1.4vw, 1.75rem)",
			"radius": "0",
			"ease": {
				"out": "cubic-bezier(0.16, 1, 0.3, 1)",
				"inOut": "cubic-bezier(0.65, 0, 0.35, 1)"
			},
			"duration": {
				"fast": "160ms",
				"base": "280ms",
				"slow": "720ms",
				"reveal": "1100ms"
			},
			"tracking": {
				"label": "0.18em",
				"button": "0.14em",
				"display": "-0.012em"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ivory)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1rem, -0.2rem + 5.4vw, 5rem)",
				"right": "clamp(1rem, -0.2rem + 5.4vw, 5rem)"
			},
			"blockGap": "0"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "300",
					"lineHeight": "1.12",
					"letterSpacing": "-0.012em"
				},
				"color": {
					"text": "var(--text-display)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h1)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h2)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h3)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h4)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h5)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h6)"
				}
			},
			"link": {
				"color": {
					"text": "var(--text-link)"
				},
				":hover": {
					"color": {
						"text": "var(--text-link-hover)"
					}
				},
				"typography": {
					"textDecoration": "underline"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text": "var(--wp--preset--color--ivory)"
				},
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600",
					"fontSize": "0.78rem",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)"
				},
				"color": {
					"text": "var(--wp--preset--color--slate)"
				}
			}
		}
	},
