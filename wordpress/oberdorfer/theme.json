		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "4px",
					"size": "0.25rem"
				},
				{
					"slug": "20",
					"name": "8px",
					"size": "0.5rem"
				},
				{
